  .cbox:hover{border-color:var(--purple);box-shadow:var(--npu);transform:translateY(-4px)}
  .cbox b{display:block;font-family:'Orbitron';color:var(--cyan);font-size:.82rem;letter-spacing:2px;margin-bottom:8px;text-shadow:0 0 10px rgba(0,245,255,.5)}
  .cbox a{font-weight:700;font-size:1.08rem}
  .cbox a:hover{color:var(--cyan);text-shadow:var(--nc)}

