  .frow input,.frow select{width:100%;padding:14px 16px;border-radius:13px;border:1.5px solid rgba(0,245,255,.3);background:rgba(4,4,13,.75);color:var(--text);font-family:'Rajdhani';font-weight:600;font-size:1.02rem;transition:.2s}
