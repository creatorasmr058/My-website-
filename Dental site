<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&family=Rajdhani:wght@400;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#04040d; --panel:rgba(13,13,32,.72);
    --cyan:#00f5ff; --pink:#ff2fb9; --purple:#9d5cff; --lime:#39ff88;
    --text:#eaf6ff; --muted:#93a7c4;
    --nc:0 0 8px rgba(0,245,255,.9),0 0 24px rgba(0,245,255,.6),0 0 64px rgba(0,245,255,.35);
    --np:0 0 8px rgba(255,47,185,.9),0 0 24px rgba(255,47,185,.6),0 0 64px rgba(255,47,185,.35);
    --npu:0 0 8px rgba(157,92,255,.9),0 0 24px rgba(157,92,255,.6),0 0 64px rgba(157,92,255,.35);
  }
  *{margin:0;padding:0;box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{font-family:'Rajdhani',system-ui,sans-serif;background:var(--bg);color:var(--text);overflow-x:hidden}
  .wrap{max-width:1180px;margin:0 auto;padding:0 24px}
  a{text-decoration:none;color:inherit}
  h1,h2,h3,.logo,.stat b{font-family:'Orbitron',sans-serif}
  ::selection{background:var(--pink);color:#fff}

  /* fixed layers */
  #rain{position:fixed;inset:0;z-index:1;pointer-events:none}
  #webgl{position:fixed;inset:0;z-index:0;pointer-events:none}
  .content{position:relative;z-index:2}
  #progress{position:fixed;top:0;left:0;height:3px;width:0;z-index:100;background:linear-gradient(90deg,var(--cyan),var(--pink),var(--purple));box-shadow:0 0 12px var(--cyan)}
  body::after{content:"";position:fixed;inset:0;z-index:0;pointer-events:none;
    background:radial-gradient(1000px 600px at 75% -10%,rgba(157,92,255,.16),transparent 60%),
               radial-gradient(800px 500px at 12% 115%,rgba(0,245,255,.12),transparent 60%)}

  /* cursor glow */
  .cursor{position:fixed;z-index:99;width:26px;height:26px;border-radius:50%;pointer-events:none;
    background:radial-gradient(circle,rgba(0,245,255,.9),transparent 70%);filter:blur(2px);
    transform:translate(-50%,-50%);transition:opacity .3s;mix-blend-mode:screen}
  .cursor.p{background:radial-gradient(circle,rgba(255,47,185,.95),transparent 70%)}

  /* NAV */
  nav{position:sticky;top:0;z-index:60;background:rgba(4,4,13,.75);backdrop-filter:blur(14px);border-bottom:1px solid rgba(0,245,255,.22)}
  .navbar{display:flex;justify-content:space-between;align-items:center;height:72px}
  .logo{display:flex;align-items:center;gap:12px;font-weight:900;letter-spacing:1.5px;font-size:1.05rem}
  .logo .mark{width:44px;height:44px;border-radius:13px;display:flex;align-items:center;justify-content:center;font-size:1.25rem;
    background:var(--panel);border:2px solid var(--cyan);box-shadow:var(--nc);animation:pulse 3s ease-in-out infinite}
  @keyframes pulse{50%{box-shadow:0 0 10px rgba(0,245,255,1),0 0 44px rgba(0,245,255,.75)}}
  .logo b{color:var(--pink);text-shadow:var(--np)}
  .links{display:flex;gap:28px;align-items:center;font-weight:700;letter-spacing:.5px}
  .links a{color:var(--muted);transition:.2s}
  .links a:hover{color:var(--cyan);text-shadow:var(--nc)}
  .btn{display:inline-block;padding:12px 26px;border-radius:999px;font-weight:700;letter-spacing:1px;font-size:1rem;border:none;cursor:pointer;transition:.25s;font-family:'Rajdhani';position:relative}
  .btn.neon{color:var(--cyan);background:rgba(0,245,255,.05);border:2px solid var(--cyan);box-shadow:var(--nc)}
  .btn.neon:hover{background:var(--cyan);color:#02131a;transform:translateY(-2px) scale(1.02)}
  .btn.pink{color:var(--pink);background:rgba(255,47,185,.05);border:2px solid var(--pink);box-shadow:var(--np)}
  .btn.pink:hover{background:var(--pink);color:#1a0212;transform:translateY(-2px) scale(1.02)}

  /* HERO */
  .hero{min-height:100vh;display:flex;align-items:center}
  .hero .wrap{display:grid;grid-template-columns:1.1fr .9fr;gap:30px;align-items:center;padding:90px 24px 120px}
  .pill{display:inline-flex;gap:10px;align-items:center;padding:8px 18px;border-radius:999px;border:1.5px solid var(--lime);color:var(--lime);font-weight:700;letter-spacing:2.5px;font-size:.78rem;box-shadow:0 0 14px rgba(57,255,136,.4)}
  .pill i{width:9px;height:9px;border-radius:50%;background:var(--lime);box-shadow:0 0 12px var(--lime);animation:blink 1.5s infinite}
  @keyframes blink{50%{opacity:.25}}
  h1{font-size:3.6rem;line-height:1.1;font-weight:900;margin:22px 0 18px;letter-spacing:1px}
  h1 .c{color:var(--cyan);text-shadow:var(--nc)}
  h1 .p{color:var(--pink);text-shadow:var(--np)}
  .lead{color:var(--muted);font-size:1.18rem;max-width:32rem;font-weight:600}
  .hero-cta{display:flex;gap:16px;margin-top:32px;flex-wrap:wrap}
  .stats{display:flex;gap:38px;margin-top:46px;flex-wrap:wrap}
  .stat b{display:block;font-size:1.55rem;color:var(--cyan);text-shadow:var(--nc)}
  .stat b.pk{color:var(--pink);text-shadow:var(--np)}
  .stat b.pu{color:var(--purple);text-shadow:var(--npu)}
  .stat span{color:var(--muted);font-size:.88rem;font-weight:700;letter-spacing:1px}

  /* MARQUEE */
  .marquee{overflow:hidden;border-top:1px solid rgba(0,245,255,.25);border-bottom:1px solid rgba(255,47,185,.25);background:rgba(13,13,32,.5);padding:14px 0;position:relative;z-index:2}
  .mtrack{display:flex;gap:48px;white-space:nowrap;font-family:'Orbitron';font-weight:700;letter-spacing:3px;font-size:.85rem;animation:mar 26s linear infinite;width:max-content}
  .mtrack span{color:var(--cyan);text-shadow:var(--nc)}
  .mtrack em{color:var(--pink);text-shadow:var(--np);font-style:normal}
