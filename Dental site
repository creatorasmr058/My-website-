<script>
/* ---------- scroll progress ---------- */
const bar = document.getElementById('progress');
addEventListener('scroll', () => {
  const h = document.documentElement;
  bar.style.width = (h.scrollTop / (h.scrollHeight - h.clientHeight) * 100) + '%';
}, { passive: true });

/* ---------- neon cursor ---------- */
const cur = document.getElementById('cur');
addEventListener('pointermove', e => {
  cur.style.left = e.clientX + 'px';
  cur.style.top = e.clientY + 'px';
});
document.querySelectorAll('.btn, .ncard, a').forEach(el => {
  el.addEventListener('pointerenter', () => cur.classList.add('p'));
  el.addEventListener('pointerleave', () => cur.classList.remove('p'));
});

/* ---------- reveal on scroll ---------- */
const io = new IntersectionObserver(es => {
  es.forEach(en => {
    if (!en.isIntersecting) return;
    const sibs = [...en.target.parentElement.children].filter(c => c.classList.contains('rv'));
    sibs.forEach((c, i) => setTimeout(() => c.classList.add('on'), i * 110));
    io.unobserve(en.target);
  });
}, { threshold: 0.18 });
document.querySelectorAll('.rv').forEach(el => io.observe(el));

/* ---------- 3D tilt cards ---------- */
document.querySelectorAll('.ncard').forEach(card => {
  card.addEventListener('pointermove', e => {
    const r = card.getBoundingClientRect();
    const x = (e.clientX - r.left) / r.width - 0.5;
    const y = (e.clientY - r.top) / r.height - 0.5;
    card.style.transform = `rotateY(${x * 14}deg) rotateX(${-y * 14}deg) translateZ(14px)`;
  });
  card.addEventListener('pointerleave', () => card.style.transform = '');
});

/* ---------- TOOTH RAIN (teeth fall from the top as you scroll) ---------- */
(() => {
  const cv = document.getElementById('rain');
  const ctx = cv.getContext('2d');
  let W, H, teeth = [], scrollBoost = 0, lastY = scrollY;
  const NEON = ['#00f5ff', '#ff2fb9', '#9d5cff'];

  function resize() {
    W = cv.width = innerWidth * devicePixelRatio;
    H = cv.height = innerHeight * devicePixelRatio;
    cv.style.width = innerWidth + 'px';
    cv.style.height = innerHeight + 'px';
  }
  addEventListener('resize', resize); resize();

  function spawn(burst) {
    const t = {
      x: Math.random() * W,
      y: -60 * devicePixelRatio - Math.random() * 300 * devicePixelRatio,
      s: (0.9 + Math.random() * 1.7) * devicePixelRatio,
      v: (0.7 + Math.random() * 1.6) * devicePixelRatio,
      r: Math.random() * Math.PI * 2,
      vr: (Math.random() - 0.5) * 0.04,
      c: NEON[Math.floor(Math.random() * 3)],
      o: 0.35 + Math.random() * 0.5
    };
    if (burst) { t.v += 6 * devicePixelRatio; t.o = 0.9; }
    teeth.push(t);
  }
  for (let i = 0; i < 26; i++) {
    spawn();
    teeth[i].y = Math.random() * H; // pre-fill the screen
  }

  addEventListener('scroll', () => {
    const dy = Math.abs(scrollY - lastY); lastY = scrollY;
    scrollBoost = Math.min(scrollBoost + dy * 0.12, 14);
    // burst extra teeth when scrolling fast
    const n = Math.min(Math.floor(dy / 90), 5);
    for (let i = 0; i < n; i++) spawn(true);
  }, { passive: true });

  (function tick() {
    requestAnimationFrame(tick);
    ctx.clearRect(0, 0, W, H);
    const speed = 1 + scrollBoost;
    scrollBoost *= 0.94;
    for (let i = teeth.length - 1; i >= 0; i--) {
      const t = teeth[i];
      t.y += t.v * speed;
      t.x += Math.sin(t.y * 0.004 + t.r) * 0.6;
      t.r += t.vr;
      if (t.y > H + 80) { teeth.splice(i, 1); continue; }
      ctx.save();
      ctx.translate(t.x, t.y);
      ctx.rotate(t.r);
      ctx.font = `${22 * t.s}px serif`;
      ctx.shadowColor = t.c;
      ctx.shadowBlur = 24 * devicePixelRatio;
      ctx.fillStyle = t.c;
      ctx.globalAlpha = t.o;
      ctx.fillText('🦷', -11 * t.s, 8 * t.s);
      ctx.shadowBlur = 0;
      ctx.globalAlpha = 1;
      ctx.fillText('🦷', -11 * t.s, 8 * t.s);
      ctx.restore();
    }
    while (teeth.length < 26) spawn();
  })();
})();

/* ---------- WEBGL NEON 3D TOOTH (fixed background, right side) ---------- */
(async () => {
  let THREE;
  try {
    THREE = await import('https://unpkg.com/three@0.160.0/build/three.module.js');
  } catch (e) { return; /* rain + n
