    .hero .wrap,.book-grid{grid-template-columns:1fr}
    h1{font-size:2.3rem}
    .cards,.steps,.contact-grid{grid-template-columns:1fr}
    .links a:not(.btn){display:none}
    .cursor{display:none}
  }
</style>
